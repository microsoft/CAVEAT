  echo "Submission manifest: $manifest"
}

cmd_submit() (
  [[ $# -ge 2 ]] || die "submit requires NAME COMMAND [ARGS...]"
  require_p0
  validate_gpu_cap
  validate_command_safety "${@:2}"
  validate_resume_target
  cluster_checks
  kubectl -n "$NAMESPACE" get secret "$HF_SECRET" >/dev/null \
    || die "missing secret $HF_SECRET; run: cluster/b200/b200 setup"
  local name="$1"; shift
  [[ "$name" =~ ^[a-z0-9]([-a-z0-9]*[a-z0-9])?$ ]] || die "NAME must be lowercase DNS syntax"
  # The staging helper expands NAME to
  # USER_ALIAS-pvc-copy-NAME<RANDOM>-loader-0. Kubernetes validates each
  # generated pod-name component at 63 characters, so reject an overlong name
  # before source staging instead of failing inside the admission webhook.
  local transfer_prefix="-pvc-copy-" transfer_pod_suffix="-loader-0"
  local transfer_name_overhead=$(( ${#USER_ALIAS} + ${#transfer_prefix} + 5 + ${#transfer_pod_suffix} ))
  local maximum_name_length=$((63 - transfer_name_overhead))
  (( ${#name} <= maximum_name_length )) \
    || die "NAME is too long for the transfer pod; maximum is $maximum_name_length characters"
  local nodes="${NODES:-1}" gpus_per_node="${GPUS_PER_NODE:-8}"
  local source_dir="${SOURCE_DIR:-.}" source_git_sha=""
  require_reproducible_source "$source_dir"
  if git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    source_git_sha="$(git -C "$source_dir" rev-parse HEAD)"
    [[ "$source_git_sha" =~ ^[0-9a-f]{40}$ ]] \
      || die "SOURCE_DIR has an invalid Git commit identity"
  elif [[ "${B200_ALLOW_DIRTY_SOURCE:-0}" != 1 ]]; then
    die "SOURCE_DIR must be a Git worktree for a provenance-bound scientific run"
  fi
  [[ "$nodes" =~ ^[1-9][0-9]*$ ]] || die "NODES must be a positive integer"
  [[ "$gpus_per_node" =~ ^[0-9]+$ ]] || die "GPUS_PER_NODE must be a nonnegative integer"
  local requested=$((nodes * gpus_per_node)) active_before
  local shadow="" GPU_LOCK_HELD=0 GPU_LOCK_NAME="" GPU_LOCK_OWNER=""
  cleanup_submit() {
    release_submission_lock
    [[ -z "$shadow" ]] || rm -rf "$shadow"
  }
  trap cleanup_submit EXIT
  acquire_submission_lock
  active_before="$(active_gpu_total)"
  guard_gpu_budget "$requested"

  local image="${CONTAINER_IMAGE_PATH:-$DEFAULT_CONTAINER_IMAGE}"
  require_pinned_image "$image"
  export CONTAINER_IMAGE_PATH="$image"
  export TOTAL_GPUS="$requested"
  # CONTAINER_IMAGE_PATH is normally consumed only while envsubst renders the
  # Volcano object.  Expose the same validated immutable identity inside the
  # scientific pod so artifacts can bind themselves to their actual image.
  export LAST_CONTAINER_IMAGE_DIGEST="$image"
  # Source staging deliberately excludes .git.  Carry the already-validated
  # clean commit identity into the pod so scientific provenance does not
  # degrade to an unverifiable null merely because the source is archived.
  export LAST_SOURCE_GIT_SHA="$source_git_sha"

  # Use a private copy of the installed bundle so HF_TOKEN is injected by
  # secretKeyRef. The stock TRANSFER_VARS path prints and persists secrets.
  shadow="$(mktemp -d -t b200-submit.XXXXXXXX)"
  cp "$TOOLS_DIR"/{vsubmit.sh,copy2pvc.sh,copyignore_filter.py,volcano_job.yaml,volcano_command.sh} "$shadow/"
  chmod +x "$shadow"/*.sh
  harden_copy_helper "$shadow/copy2pvc.sh"
  harden_vsubmit_for_resume "$shadow/vsubmit.sh"
  # The cluster capacity reaper classifies jobs from the Volcano object's
  # metadata label, independently of the pod scheduler's priorityClassName.
  # Keep both representations explicit: p0 is the capacity-policy request,
  # while ${PRIORITY} below renders to the scheduler class "high".
  [[ "$(grep -c '^[[:space:]]*workstream: "${PROJECT_NAME}"[[:space:]]*$' "$shadow/volcano_job.yaml")" -eq 1 ]] \
    || die "installed submitter layout changed; refusing to launch without a unique workstream label anchor"
  [[ "$(grep -c '^    priority:' "$shadow/volcano_job.yaml")" -eq 0 ]] \
    || die "installed submitter already defines a conflicting Volcano metadata priority"
  sed -i '/^[[:space:]]*workstream: "${PROJECT_NAME}"[[:space:]]*$/a\    priority: "p0"' \
    "$shadow/volcano_job.yaml"
  [[ "$(grep -c '^    priority:' "$shadow/volcano_job.yaml")" -eq 1 \
    && "$(grep -c '^    priority: "p0"$' "$shadow/volcano_job.yaml")" -eq 1 ]] \
    || die "failed to install the required Volcano metadata priority=p0 label"
  sed -i '/- name: START_COMMAND/i\                - name: LAST_CONTAINER_IMAGE_DIGEST\n                  value: "${CONTAINER_IMAGE_PATH}"\n                - name: LAST_SOURCE_GIT_SHA\n                  value: "${LAST_SOURCE_GIT_SHA}"\n                - name: LAST_CLUSTER_PRIORITY_REQUEST\n                  value: "p0"\n                - name: LAST_CLUSTER_PRIORITY_CLASS\n                  value: "${PRIORITY}"\n                - name: LAST_ALLOCATED_NODES\n                  value: "${NODES}"\n                - name: LAST_GPUS_PER_NODE\n                  value: "${GPUS_PER_NODE}"\n                - name: LAST_ALLOCATED_GPUS\n                  value: "${TOTAL_GPUS}"\n                - name: HF_TOKEN\n                  valueFrom:\n                    secretKeyRef:\n                      name: '"$HF_SECRET"'\n                      key: HF_TOKEN' "$shadow/volcano_job.yaml"
  if [[ -n "$IMAGE_PULL_SECRET" ]]; then
    sed -i '/^[[:space:]]*spec: &podspec$/a\          imagePullSecrets:\n            - name: '"$IMAGE_PULL_SECRET" \
      "$shadow/volcano_job.yaml"
  fi

  # Recheck immediately before the scientific object is created. This closes
  # the source-staging window during which another job might have appeared.
  export -f die active_gpu_total validate_gpu_cap guard_gpu_budget release_submission_lock attest_scientific_priority
  export USER_ALIAS NAMESPACE GPU_CAP HARD_GPU_CAP GPU_LOCK_HELD GPU_LOCK_NAME GPU_LOCK_OWNER
  sed -i \
    -e '/^VCJOB_FQN=$(kubectl create/i guard_gpu_budget "$((NODES * GPUS_PER_NODE))"' \
    -e '/^echo "Created:/i attest_scientific_priority "$VCJOB_FQN"' \
    -e '/^echo "Created:/a release_submission_lock\
VCJOB_NAME="${VCJOB_FQN#*/}"\
if [[ -n "${B200_SCIENTIFIC_ID_FILE:-}" ]]; then printf '\''%s\\n'\'' "$VCJOB_NAME" >"$B200_SCIENTIFIC_ID_FILE"; fi\
exit 0' \
    "$shadow/vsubmit.sh"
  grep -q 'B200_SCIENTIFIC_ID_FILE' "$shadow/vsubmit.sh" \
    || die "installed submitter layout changed; refusing to launch without durable job-ID capture"

  local started_at finished_at rc submit_rc monitor_rc job_name staging_dir
  local source_transfer_job="" terminal_summary_file="$shadow/terminal-summary.json"
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  set +e
  VOLCANO_NAMESPACE="$NAMESPACE" VOLCANO_DATA_PVC_NAME="$PVC" \
  PROJECT_NAME="$WORKSTREAM" PRIORITY="$(priority_class "$PRIORITY")" \
  JOB_NAME="$name" INSTALL_PACKAGE="${INSTALL_PACKAGE:-0}" \
  USE_TORCHRUN="${USE_TORCHRUN:-0}" TRANSFER_VARS="" \
  B200_TRANSFER_ID_FILE="$shadow/source-transfer-job-id" \
  B200_SCIENTIFIC_ID_FILE="$shadow/scientific-job-id" \
    bash "$shadow/vsubmit.sh" "$@"
  submit_rc=$?
  set -e
  if [[ -f "$shadow/scientific-job-id" ]]; then
    job_name="$(<"$shadow/scientific-job-id")"
  else
    job_name="$(find_submitted_job "$name" "$started_at" || true)"
  fi
  staging_dir="$(latest_staging_dir "$name" "$started_at" || true)"
  [[ ! -f "$shadow/source-transfer-job-id" ]] \
    || source_transfer_job="$(<"$shadow/source-transfer-job-id")"
  if [[ -n "$job_name" ]]; then
    echo "Captured scientific job ID: $job_name"
    if [[ -n "${B200_RESUME_JOB_OUT_DIR:-}" ]]; then
      echo "Remote output: ${B200_RESUME_JOB_OUT_DIR} (verified recovery target)"
    elif [[ -n "$staging_dir" ]]; then
      echo "Remote output: ${OUT_DIR:-/data/runs/$USER_ALIAS}/$(basename "$staging_dir")"
    fi
    set +e
    monitor_submitted_job "$job_name" "$terminal_summary_file"
    monitor_rc=$?
    set -e
    rc=$monitor_rc
    if (( submit_rc != 0 )); then
      echo "b200: submitter returned rc=$submit_rc after creating $job_name; terminal cluster state is authoritative" >&2
    fi
  else
    rc=$submit_rc
    (( rc != 0 )) || rc=1
    echo "b200: submitter did not yield a scientific job ID" >&2
  fi
  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  record_submission "$name" "$started_at" "$finished_at" "$rc" "$requested" \
    "$active_before" "$image" "${SOURCE_DIR:-.}" "$job_name" "$staging_dir" \
    "$source_transfer_job" "$terminal_summary_file" "$@"
  # Run normal-path cleanup while cmd_submit's local variables are still in
  # scope.  Leaving it solely to an EXIT trap can make bash evaluate the trap
  # after function-local state has unwound, producing a misleading post-success
  # nounset error even though the scientific job and manifest completed.
  cleanup_submit
  trap - EXIT
  exit "$rc"
)

cmd_status() {
  cluster_checks
  if [[ $# -eq 0 ]]; then
    kubectl -n "$NAMESPACE" get vcjob -l submitter="$USER_ALIAS" \
      -o custom-columns=NAME:.metadata.name,WORKSTREAM:.metadata.labels.workstream,STATE:.status.state.phase,AGE:.metadata.creationTimestamp
  else
    kubectl -n "$NAMESPACE" get vcjob "$1" -o wide
    kubectl -n "$NAMESPACE" get pods -l volcano.sh/job-name="$1" -o wide
  fi
}

cmd_logs() {
  [[ $# -eq 1 ]] || die "logs requires JOB"
  cluster_checks
  local pods
  pods="$(kubectl -n "$NAMESPACE" get pods -l volcano.sh/job-name="$1" -o name)"
  [[ -n "$pods" ]] || die "no pods found for job $1"
  while read -r pod; do kubectl -n "$NAMESPACE" logs -f "$pod" & done <<<"$pods"
  wait
}

cmd_cancel() {
  [[ $# -eq 1 ]] || die "cancel requires exactly one JOB"
  cluster_checks
  kubectl -n "$NAMESPACE" delete vcjob "$1"
}

command="${1:-help}"; [[ $# -gt 0 ]] && shift
case "$command" in
  doctor) cmd_doctor "$@" ;;
  setup) cmd_setup "$@" ;;
  upload) cmd_upload "$@" ;;
  download) cmd_download "$@" ;;
  submit) cmd_submit "$@" ;;
  status) cmd_status "$@" ;;
  logs) cmd_logs "$@" ;;
  cancel) cmd_cancel "$@" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
