tree_sha256() {
  local directory="$1"
  [[ -d "$directory" ]] || return 0
  tar --sort=name --mtime='UTC 1970-01-01' --owner=0 --group=0 --numeric-owner \
    -C "$directory" -cf - . | sha256sum | cut -d' ' -f1
}

record_submission() {
  local configured_name="$1" started_at="$2" finished_at="$3" rc="$4"
  local requested="$5" active_before="$6" image="$7" source_dir="$8"
  local job_name="$9" staging_dir="${10}" source_transfer_job="${11}"
  local terminal_summary_file="${12}"; shift 12
  local git_sha="" dirty="unknown" source_hash="" vcjob_file="" rendered_file=""
  local hash_root="$source_dir"
  mkdir -p "$MANIFEST_DIR"
  if git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    git_sha="$(git -C "$source_dir" rev-parse HEAD)"
    if [[ -z "$(git -C "$source_dir" status --porcelain --untracked-files=all)" ]]; then
      dirty=false
    else
      dirty=true
    fi
  fi
  if [[ -n "$staging_dir" ]]; then
    source_hash="$(tree_sha256 "$staging_dir/source_dir" || true)"
    [[ ! -d "$staging_dir/source_dir" ]] || hash_root="$staging_dir/source_dir"
  fi
  local record_id="${started_at//[:.]/-}-${configured_name}"
  record_id="${record_id//+00-00/Z}"
  local manifest="$MANIFEST_DIR/${record_id}.json" tmp="$MANIFEST_DIR/.${record_id}.tmp"
  if [[ -n "$job_name" ]]; then
    vcjob_file="$MANIFEST_DIR/${record_id}.vcjob.json"
    kubectl -n "$NAMESPACE" get vcjob "$job_name" -o json >"$vcjob_file" 2>/dev/null || vcjob_file=""
  fi
  if [[ -n "$staging_dir" && -f "$staging_dir/volcano_rendered.yaml" ]]; then
    rendered_file="$MANIFEST_DIR/${record_id}.rendered.yaml"
    cp "$staging_dir/volcano_rendered.yaml" "$rendered_file"
  fi
  B200_RECORD_CONFIGURED_NAME="$configured_name" \
  B200_RECORD_STARTED_AT="$started_at" B200_RECORD_FINISHED_AT="$finished_at" \
  B200_RECORD_RC="$rc" B200_RECORD_REQUESTED="$requested" \
  B200_RECORD_ACTIVE_BEFORE="$active_before" B200_RECORD_IMAGE="$image" \
  B200_RECORD_SOURCE_DIR="$(realpath "$source_dir")" B200_RECORD_GIT_SHA="$git_sha" \
  B200_RECORD_HASH_ROOT="$(realpath "$hash_root")" \
  B200_RECORD_DIRTY="$dirty" B200_RECORD_SOURCE_HASH="$source_hash" \
  B200_RECORD_JOB_NAME="$job_name" B200_RECORD_STAGING_DIR="$staging_dir" \
  B200_RECORD_SOURCE_TRANSFER_JOB="$source_transfer_job" \
  B200_RECORD_TERMINAL_SUMMARY_FILE="$terminal_summary_file" \
  B200_RECORD_VCJOB_FILE="$vcjob_file" B200_RECORD_RENDERED_FILE="$rendered_file" \
  B200_RECORD_NAMESPACE="$NAMESPACE" B200_RECORD_PVC="$PVC" \
  B200_RECORD_WORKSTREAM="$WORKSTREAM" B200_RECORD_PRIORITY_REQUEST="p0" \
  B200_RECORD_PRIORITY="high" \
  B200_RECORD_USER_ALIAS="$USER_ALIAS" \
  B200_RECORD_OUT_DIR="${OUT_DIR:-/data/runs/$USER_ALIAS}" \
  B200_RECORD_RESUME_OUTPUT="${B200_RESUME_JOB_OUT_DIR:-}" \
  B200_RECORD_RESUME_IDENTITY="${B200_RESUME_IDENTITY_SHA256:-}" \
  B200_RECORD_NODES="${NODES:-1}" B200_RECORD_GPUS_PER_NODE="${GPUS_PER_NODE:-8}" \
  B200_RECORD_HARD_GPU_CAP="$HARD_GPU_CAP" B200_RECORD_EFFECTIVE_GPU_CAP="$GPU_CAP" \
  B200_RECORD_HELPER="$(realpath "${BASH_SOURCE[0]}")" \
  B200_RECORD_MANIFEST="$manifest" python3 - "$tmp" "$@" <<'PY'
import hashlib
import json
import os
from pathlib import Path
import sys

tmp = Path(sys.argv[1])
argv = sys.argv[2:]
env = os.environ
source_path = Path(env["B200_RECORD_HASH_ROOT"])

def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()

input_files = {}
for argument in argv:
    raw = argument.split("=", 1)[1] if argument.startswith("--") and "=" in argument else argument
    candidate = Path(raw)
    if not candidate.is_absolute():
        candidate = source_path / candidate
    if candidate.is_file() and not candidate.name.startswith(".env"):
        input_files[raw] = sha256_file(candidate)

dirty_raw = env["B200_RECORD_DIRTY"]
dirty = {"true": True, "false": False}.get(dirty_raw)
terminal_summary_path = Path(env["B200_RECORD_TERMINAL_SUMMARY_FILE"])
terminal_summary = None
if terminal_summary_path.is_file():
    terminal_summary = json.loads(terminal_summary_path.read_text(encoding="utf-8"))
remote_output_path = None
if env["B200_RECORD_RESUME_OUTPUT"]:
    remote_output_path = env["B200_RECORD_RESUME_OUTPUT"]
elif env["B200_RECORD_STAGING_DIR"]:
    remote_output_path = "{}/{}".format(
        env["B200_RECORD_OUT_DIR"].rstrip("/"),
        Path(env["B200_RECORD_STAGING_DIR"]).name,
    )
record = {
    "schema_version": 3,
    "configured_name": env["B200_RECORD_CONFIGURED_NAME"],
    "job_name": env["B200_RECORD_JOB_NAME"] or None,
    "started_at": env["B200_RECORD_STARTED_AT"],
    "finished_at": env["B200_RECORD_FINISHED_AT"],
    "return_code": int(env["B200_RECORD_RC"]),
    "command_argv": argv,
    "command_sha256": hashlib.sha256(
        json.dumps(argv, ensure_ascii=False, separators=(",", ":")).encode()
    ).hexdigest(),
    "input_file_sha256": input_files,
    "helper_sha256": sha256_file(Path(env["B200_RECORD_HELPER"])),
    "cluster": {
        "namespace": env["B200_RECORD_NAMESPACE"],
        "pvc": env["B200_RECORD_PVC"],
        "workstream": env["B200_RECORD_WORKSTREAM"],
        "priority_request": env["B200_RECORD_PRIORITY_REQUEST"],
        "priority_class": env["B200_RECORD_PRIORITY"],
    },
    "allocation": {
        "nodes": int(env["B200_RECORD_NODES"]),
        "gpus_per_node": int(env["B200_RECORD_GPUS_PER_NODE"]),
        "requested_gpus": int(env["B200_RECORD_REQUESTED"]),
        "active_or_queued_gpus_before_submit": int(env["B200_RECORD_ACTIVE_BEFORE"]),
        "hard_gpu_cap": int(env["B200_RECORD_HARD_GPU_CAP"]),
        "effective_gpu_cap": int(env["B200_RECORD_EFFECTIVE_GPU_CAP"]),
    },
    "container_image": env["B200_RECORD_IMAGE"],
    "source": {
        "path": env["B200_RECORD_SOURCE_DIR"],
        "git_sha": env["B200_RECORD_GIT_SHA"] or None,
        "git_dirty": dirty,
        "staged_tree_sha256": env["B200_RECORD_SOURCE_HASH"] or None,
        "staging_dir": env["B200_RECORD_STAGING_DIR"] or None,
    },
    "remote_output_path": remote_output_path,
    "recovery": {
        "resumed_existing_output": bool(env["B200_RECORD_RESUME_OUTPUT"]),
        "campaign_identity_sha256": env["B200_RECORD_RESUME_IDENTITY"] or None,
    },
    "terminal": terminal_summary,
    "artifacts": {
        "vcjob_manifest": env["B200_RECORD_VCJOB_FILE"] or None,
        "rendered_manifest": env["B200_RECORD_RENDERED_FILE"] or None,
        "source_transfer_job_name": env["B200_RECORD_SOURCE_TRANSFER_JOB"] or None,
    },
}
tmp.write_text(json.dumps(record, indent=2, sort_keys=True) + "\n", encoding="utf-8")
os.replace(tmp, env["B200_RECORD_MANIFEST"])
