#!/usr/bin/env bash
set -euo pipefail

NAMESPACE="${VOLCANO_NAMESPACE:-bonete61}"
PVC="${VOLCANO_DATA_PVC_NAME:-pvc-vast-bonete61}"
WORKSTREAM="${B200_WORKSTREAM:-socialreasoning}"
PRIORITY="${B200_PRIORITY:-p0}"
USER_ALIAS="${USER%@*}"
HF_SECRET="${B200_HF_SECRET:-${USER_ALIAS}-hf-token}"
IMAGE_PULL_SECRET="${B200_IMAGE_PULL_SECRET:-}"
TOOLS_DIR="${B200_TOOLS_DIR:-${HOME}/.local/bin}"
HARD_GPU_CAP=16
GPU_CAP="${B200_MAX_GPUS:-$HARD_GPU_CAP}"
DEFAULT_CONTAINER_IMAGE="docker.io/sytelus/gpu-devbox@sha256:24e4632c1fb555ecb7bf57064313b7a784ae43286defa167534fc2d798711a39"
TRANSFER_IMAGE="docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
MANIFEST_DIR="${B200_MANIFEST_DIR:-.b200/manifests}"

die() { echo "b200: $*" >&2; exit 1; }
need() { command -v "$1" >/dev/null || die "missing required command: $1"; }

priority_class() {
  case "$1" in
    p0|high) echo high ;;
    p1|low) echo low ;;
    medium) echo medium ;;
    *) die "unsupported priority '$1' (use p0, p1, high, low, or medium)" ;;
  esac
}

require_p0() {
  [[ "$(priority_class "$PRIORITY")" == high ]] \
    || die "this repository requires B200_PRIORITY=p0 (scheduler class high)"
}

attest_scientific_priority() {
  local vcjob_fqn="$1" job_name observed
  job_name="${vcjob_fqn#*/}"
  [[ -n "$job_name" && "$job_name" != "$vcjob_fqn" ]] \
    || die "could not resolve the newly created Volcano job name for priority attestation"
  observed="$(kubectl -n "$NAMESPACE" get vcjob "$job_name" \
    -o jsonpath='{.metadata.labels.priority}' 2>/dev/null || true)"
  if [[ "$observed" != p0 ]]; then
    echo "b200: newly created $job_name has metadata priority='${observed:-<missing>}', expected p0; deleting only this unsafe submission" >&2
    kubectl -n "$NAMESPACE" delete vcjob "$job_name" --wait=false >/dev/null 2>&1 || true
    die "scientific job priority attestation failed"
  fi
  echo "Verified Volcano metadata priority: p0"
}

require_pinned_image() {
  local image="$1"
  [[ "$image" =~ @sha256:[0-9a-f]{64}$ ]] \
    || die "CONTAINER_IMAGE_PATH must be pinned by an immutable @sha256 digest"
}

validate_gpu_cap() {
  [[ "$GPU_CAP" =~ ^[0-9]+$ ]] || die "B200_MAX_GPUS must be an integer"
  (( GPU_CAP >= 0 && GPU_CAP <= HARD_GPU_CAP )) \
    || die "B200_MAX_GPUS may lower, but never exceed, the hard cap of $HARD_GPU_CAP"
}

active_gpu_total() {
  # Count desired GPU replicas for every nonterminal job belonging to this user,
  # including queued jobs that have not created pods yet. Prefix matching covers
  # older jobs that predate the submitter label.
  # Server-side label filtering avoids downloading every user's full Volcano
  # job specification (which can be both slow and needlessly expose unrelated
  # environment metadata to the local process). All jobs created by the
  # repository helper carry this submitter label.
  kubectl -n "$NAMESPACE" get vcjob \
    -l "submitter=$USER_ALIAS" --request-timeout=15s -o json | python3 -c '
import json, sys

alias = sys.argv[1]
terminal = {"aborted", "completed", "failed", "terminated"}
total = 0
for job in json.load(sys.stdin).get("items", []):
    metadata = job.get("metadata", {})
    labels = metadata.get("labels", {}) or {}
    name = metadata.get("name", "")
    if labels.get("submitter") != alias and not name.startswith(alias + "-"):
        continue
    phase = str((job.get("status", {}).get("state", {}) or {}).get("phase", "")).lower()
    if phase in terminal:
        continue
    for task in job.get("spec", {}).get("tasks", []):
        # Volcano emits optional worker task templates without ``replicas``;
        # those create no pods and therefore request zero GPUs. Scientific
        # master tasks carry an explicit replica count.
        replicas = int(task.get("replicas", 0) or 0)
        containers = task.get("template", {}).get("spec", {}).get("containers", [])
        per_replica = 0
        for container in containers:
            resources = container.get("resources", {}) or {}
            requests = resources.get("requests", {}) or {}
            limits = resources.get("limits", {}) or {}
            raw = requests.get("nvidia.com/gpu", limits.get("nvidia.com/gpu", 0))
            per_replica += int(raw or 0)
        total += replicas * per_replica
print(total)
' "$USER_ALIAS"
}

guard_gpu_budget() {
  local requested="$1" active
  validate_gpu_cap
  [[ "$requested" =~ ^[0-9]+$ ]] || die "requested GPU count must be an integer"
  (( requested <= GPU_CAP )) \
    || die "job requests $requested B200s, exceeding the configured cap of $GPU_CAP"
  active="$(active_gpu_total)"
  [[ "$active" =~ ^[0-9]+$ ]] || die "could not determine active B200 allocation"
  (( active + requested <= GPU_CAP )) \
    || die "GPU cap violation: $active active/queued + $requested requested > $GPU_CAP B200s"
  echo "GPU budget OK: $active active/queued + $requested requested <= $GPU_CAP"
}

harden_copy_helper() {
  local helper="$1"
  # The installed helper has no priority field and uses a mutable transfer tag.
  # It is copied privately before these mechanical substitutions.
  sed -i \
    -e '/schedulerName: volcano/a\          priorityClassName: high' \
    -e "s#^CONTAINER_IMAGE=.*#CONTAINER_IMAGE=${TRANSFER_IMAGE}#" \
    -e '/^VCJOB_NAME="${VCJOB_FQN#\*\/}"/a\if [[ -n "${B200_TRANSFER_ID_FILE:-}" ]]; then printf '\''%s\\n'\'' "$VCJOB_NAME" >"$B200_TRANSFER_ID_FILE"; fi' \
    "$helper"

  # A recovery upload is an overlay onto an existing scientific output.  The
  # root identity must already exist and match before the first tar byte is
  # sent; otherwise even source staging is forbidden.
  python3 - "$helper" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
needle = '''echo "Uploading '${ABS_LOCAL}' -> '${PVC_TARGET_DIR}' ..."'''
replacement = r'''if [[ -n "${B200_RESUME_JOB_OUT_DIR:-}" ]]; then
  expected_remote="${B200_RESUME_JOB_OUT_DIR#/data/}"
  [[ "${REMOTE_PATH}" == "${expected_remote}" ]] || {
    echo "ERROR: recovery target drifted before upload" >&2
    exit 1
  }
  expected_identity="${B200_RESUME_IDENTITY_SHA256:-}"
  [[ "${expected_identity}" =~ ^[0-9a-f]{64}$ ]] || {
    echo "ERROR: recovery identity digest is missing or invalid" >&2
    exit 1
  }
  identity_line=""
  if ! identity_line="$(kubectl -n "${VOLCANO_NAMESPACE}" exec "${POD_NAME}" -- \
      sh -lc "test -d '${PVC_TARGET_DIR}' && test -f '${PVC_TARGET_DIR}/campaign_identity.json' && sha256sum '${PVC_TARGET_DIR}/campaign_identity.json'" \
      2>/dev/null)"; then
    echo "ERROR: recovery output has no readable campaign_identity.json; refusing to overlay" >&2
    exit 1
  fi
  actual_identity="${identity_line%% *}"
  [[ "${actual_identity}" == "${expected_identity}" ]] || {
    echo "ERROR: recovery campaign identity mismatch; refusing to overlay" >&2
    exit 1
  }
  echo "Verified recovery campaign identity before source overlay."
fi

echo "Uploading '${ABS_LOCAL}' -> '${PVC_TARGET_DIR}' ..."'''
if text.count(needle) != 1:
    raise SystemExit("installed copy helper layout changed; recovery guard was not applied")
path.write_text(text.replace(needle, replacement), encoding="utf-8")
PY
}

harden_vsubmit_for_resume() {
  local helper="$1"
  python3 - "$helper" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
text = path.read_text(encoding="utf-8")
needle = '''export JOB_OUT_DIR=runs/${USER_ALIAS}/${JOB_NAME_FULL}-$(date +%Y-%m-%d_%H-%M-%S_%3N)
LOCAL_JOB_OUT_DIR="${LOCAL_OUT_DIR}/${JOB_OUT_DIR}"
rm -rf "${LOCAL_JOB_OUT_DIR}"
mkdir -p "${LOCAL_JOB_OUT_DIR}"'''
replacement = '''if [[ -n "${B200_RESUME_JOB_OUT_DIR:-}" ]]; then
  export JOB_OUT_DIR="${B200_RESUME_JOB_OUT_DIR#/data/}"
  LOCAL_JOB_OUT_DIR="${LOCAL_OUT_DIR}/runs/${USER_ALIAS}/${JOB_NAME_FULL}-resume-$(date +%Y-%m-%d_%H-%M-%S_%3N)"
else
  export JOB_OUT_DIR=runs/${USER_ALIAS}/${JOB_NAME_FULL}-$(date +%Y-%m-%d_%H-%M-%S_%3N)
  LOCAL_JOB_OUT_DIR="${LOCAL_OUT_DIR}/${JOB_OUT_DIR}"
fi
rm -rf "${LOCAL_JOB_OUT_DIR}"
mkdir -p "${LOCAL_JOB_OUT_DIR}"'''
if text.count(needle) != 1:
    raise SystemExit("installed submitter layout changed; recovery output patch was not applied")
path.write_text(text.replace(needle, replacement), encoding="utf-8")
PY
}

acquire_submission_lock() {
  GPU_LOCK_NAME="${USER_ALIAS}-b200-submit-lock"
  GPU_LOCK_OWNER="$(hostname):$$:$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  if ! kubectl -n "$NAMESPACE" create configmap "$GPU_LOCK_NAME" \
    --from-literal="owner=$GPU_LOCK_OWNER" >/dev/null 2>&1; then
    local owner
    owner="$(kubectl -n "$NAMESPACE" get configmap "$GPU_LOCK_NAME" \
      -o jsonpath='{.data.owner}' 2>/dev/null || true)"
    die "another B200 submission is in its atomic allocation check (${owner:-unknown owner}); retry shortly"
  fi
  GPU_LOCK_HELD=1
}

release_submission_lock() {
  [[ "${GPU_LOCK_HELD:-0}" == 1 ]] || return 0
  local owner
  owner="$(kubectl -n "$NAMESPACE" get configmap "$GPU_LOCK_NAME" \
    -o jsonpath='{.data.owner}' 2>/dev/null || true)"
  if [[ "$owner" == "$GPU_LOCK_OWNER" ]]; then
    kubectl -n "$NAMESPACE" delete configmap "$GPU_LOCK_NAME" \
      --ignore-not-found=true >/dev/null 2>&1 || true
  fi
  GPU_LOCK_HELD=0
}

record_transfer_event() {
  local kind="$1" job_name="$2" started_at="$3" finished_at="$4" rc="$5"
  local source="$6" target="$7"
  mkdir -p "$MANIFEST_DIR"
  B200_TRANSFER_KIND="$kind" B200_TRANSFER_JOB="$job_name" \
  B200_TRANSFER_STARTED="$started_at" B200_TRANSFER_FINISHED="$finished_at" \
  B200_TRANSFER_RC="$rc" B200_TRANSFER_SOURCE="$source" \
  B200_TRANSFER_TARGET="$target" B200_TRANSFER_NAMESPACE="$NAMESPACE" \
  B200_TRANSFER_PVC="$PVC" B200_TRANSFER_IMAGE="$TRANSFER_IMAGE" \
  B200_TRANSFER_LOG="$MANIFEST_DIR/transfers.jsonl" python3 - <<'PY'
import json
import os

env = os.environ
record = {
    "schema_version": 1,
    "kind": env["B200_TRANSFER_KIND"],
    "job_name": env["B200_TRANSFER_JOB"] or None,
    "started_at": env["B200_TRANSFER_STARTED"],
    "finished_at": env["B200_TRANSFER_FINISHED"],
    "return_code": int(env["B200_TRANSFER_RC"]),
    "source": env["B200_TRANSFER_SOURCE"],
    "target": env["B200_TRANSFER_TARGET"],
    "namespace": env["B200_TRANSFER_NAMESPACE"],
    "pvc": env["B200_TRANSFER_PVC"],
    "priority_class": "high",
    "requested_gpus": 0,
    "container_image": env["B200_TRANSFER_IMAGE"],
}
payload = json.dumps(record, sort_keys=True, separators=(",", ":")) + "\n"
fd = os.open(env["B200_TRANSFER_LOG"], os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
try:
    os.write(fd, payload.encode("utf-8"))
finally:
    os.close(fd)
PY
}

validate_command_safety() {
  [[ -z "${START_COMMAND:-}" ]] \
    || die "set the command through submit argv, not START_COMMAND (it cannot be safely audited)"
  [[ -z "${TRANSFER_VARS:-}" ]] \
    || die "TRANSFER_VARS is disabled because the installed submitter prints transferred values"
  local arg lower
  for arg in "$@"; do
    lower="${arg,,}"
    case "$lower" in
      --token|--token=*|--hf-token|--hf-token=*|--api-key|--api-key=*|\
      --apikey|--apikey=*|--password|--password=*|--secret|--secret=*|\
      authorization:*|authorization=*|hf_token=*|api_key=*|apikey=*|\
      password=*|secret=*|bearer=*|.env|.env.*|*/.env|*/.env.*)
        die "credential-like submit argument rejected; use a Kubernetes secret reference"
        ;;
    esac
  done
}

validate_resume_target() {
  local target="${B200_RESUME_JOB_OUT_DIR:-}"
  local identity="${B200_RESUME_IDENTITY_SHA256:-}"
  if [[ -z "$target" ]]; then
    [[ -z "$identity" ]] \
      || die "B200_RESUME_IDENTITY_SHA256 requires B200_RESUME_JOB_OUT_DIR"
    return 0
  fi
  [[ -n "$identity" ]] \
    || die "B200_RESUME_JOB_OUT_DIR requires B200_RESUME_IDENTITY_SHA256"
  local prefix="/data/runs/${USER_ALIAS}/" relative
  [[ "$target" == "$prefix"* ]] \
    || die "recovery output must be beneath ${prefix}"
  relative="${target#"$prefix"}"
  [[ "$relative" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$ ]] \
    || die "recovery output contains an unsafe path component"
  [[ "$identity" =~ ^[0-9a-f]{64}$ ]] \
    || die "B200_RESUME_IDENTITY_SHA256 must be exactly 64 lowercase hex characters"
}

require_reproducible_source() {
  local source_dir="$1"
  [[ -d "$source_dir" ]] || die "SOURCE_DIR is not a directory: $source_dir"
  if git -C "$source_dir" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
    && [[ -n "$(git -C "$source_dir" status --porcelain --untracked-files=all)" ]] \
    && [[ "${B200_ALLOW_DIRTY_SOURCE:-0}" != 1 ]]; then
    die "SOURCE_DIR has uncommitted/untracked files; commit them or set B200_ALLOW_DIRTY_SOURCE=1 for a labeled engineering-only run"
  fi
}

usage() {
  cat <<'EOF'
Usage: cluster/b200/b200 COMMAND [ARGS]

Commands:
  doctor                         Verify tools, auth, namespace, PVC, and secret
  setup [ENV_FILE]               Create/update the HF token secret (default .env)
  upload LOCAL_DIR REMOTE_DIR    Copy a directory to /data/REMOTE_DIR
  download REMOTE_DIR LOCAL_DIR  Copy /data/REMOTE_DIR back to a local directory
  submit NAME COMMAND [ARGS...]  Submit one B200 job (defaults: socialreasoning, P0)
  status [JOB]                   List this user's jobs, or show one job and its pods
  logs JOB                       Stream logs for all pods belonging to a job
  cancel JOB                     Delete one explicitly named job

Configuration: VOLCANO_NAMESPACE, VOLCANO_DATA_PVC_NAME, B200_WORKSTREAM,
B200_PRIORITY, B200_MAX_GPUS (may only lower the hard cap of 16), B200_HF_SECRET,
B200_IMAGE_PULL_SECRET (optional), B200_TOOLS_DIR, and B200_MANIFEST_DIR. For
submit, the standard vsubmit variables
(SOURCE_DIR, NODES, GPUS_PER_NODE, CONTAINER_IMAGE_PATH, etc.) apply. Scientific
container images must use an immutable @sha256 digest; transfers are pinned too.
Dirty source trees are rejected unless B200_ALLOW_DIRTY_SOURCE=1 is explicitly
set for an engineering-only run. Recovery submissions must pair an exact
B200_RESUME_JOB_OUT_DIR beneath /data/runs/<alias>/ with the expected
B200_RESUME_IDENTITY_SHA256; use a campaign-specific launcher to compute it.
EOF
}

cluster_checks() {
  need kubectl
  need python3
  kubectl get namespace "$NAMESPACE" >/dev/null
  kubectl -n "$NAMESPACE" get pvc "$PVC" >/dev/null
  kubectl -n "$NAMESPACE" auth can-i create jobs.batch.volcano.sh | grep -qx yes \
    || die "not authorized to create Volcano jobs in $NAMESPACE"
  if [[ -n "$IMAGE_PULL_SECRET" ]]; then
    [[ "$IMAGE_PULL_SECRET" =~ ^[a-z0-9]([-a-z0-9.]*[a-z0-9])?$ ]] \
      || die "B200_IMAGE_PULL_SECRET is not a valid Kubernetes object name"
    kubectl -n "$NAMESPACE" get secret "$IMAGE_PULL_SECRET" >/dev/null \
      || die "image-pull secret $IMAGE_PULL_SECRET does not exist in $NAMESPACE"
  fi
}

cmd_doctor() {
  require_p0
  validate_gpu_cap
  cluster_checks
  need tar
  [[ -x "$TOOLS_DIR/vsubmit.sh" ]] || die "missing $TOOLS_DIR/vsubmit.sh"
  [[ -x "$TOOLS_DIR/copy2pvc.sh" ]] || die "missing $TOOLS_DIR/copy2pvc.sh"
  kubectl -n "$NAMESPACE" get secret "$HF_SECRET" >/dev/null \
    || die "missing secret $HF_SECRET; run: cluster/b200/b200 setup"
  echo "B200 access OK"
  echo "  context:    $(kubectl config current-context)"
  echo "  namespace:  $NAMESPACE"
  echo "  PVC:        $PVC"
  echo "  workstream: $WORKSTREAM"
  echo "  priority:   $PRIORITY -> $(priority_class "$PRIORITY")"
  echo "  HF secret:  $HF_SECRET"
  echo "  image pull: ${IMAGE_PULL_SECRET:-cluster/default public-image path}"
}

cmd_setup() (
  cluster_checks
  local env_file="${1:-.env}"
  [[ -f "$env_file" ]] || die "environment file not found: $env_file"
  grep -q '^HF_TOKEN=' "$env_file" || die "$env_file does not define HF_TOKEN"
  # Never pass the whole dotenv file to Kubernetes: it may contain unrelated
  # credentials. Materialize one mode-0600, one-key input without displaying it.
  umask 077
  local token_env
  token_env="$(mktemp -t b200-hf-token.XXXXXXXX)"
  trap 'rm -f "$token_env"' EXIT
  grep -m1 '^HF_TOKEN=' "$env_file" >"$token_env"
  kubectl -n "$NAMESPACE" create secret generic "$HF_SECRET" \
    --from-env-file="$token_env" --dry-run=client -o yaml | kubectl apply -f - >/dev/null
  echo "Configured $HF_SECRET in namespace $NAMESPACE (token value not displayed)."
)

cmd_upload() (
  [[ $# -eq 2 ]] || die "upload requires LOCAL_DIR REMOTE_DIR"
  require_p0
  cluster_checks
  [[ -d "$1" ]] || die "local directory not found: $1"
  local shadow
  shadow="$(mktemp -d -t b200-upload.XXXXXXXX)"
  trap 'rm -rf "$shadow"' EXIT
  cp "$TOOLS_DIR"/{copy2pvc.sh,copyignore_filter.py} "$shadow/"
  chmod +x "$shadow/copy2pvc.sh"
  harden_copy_helper "$shadow/copy2pvc.sh"
  local started_at finished_at rc job_name=""
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  set +e
  B200_TRANSFER_ID_FILE="$shadow/job-id" \
    VOLCANO_NAMESPACE="$NAMESPACE" VOLCANO_DATA_PVC_NAME="$PVC" \
    JOB_NAME="pvc-upload-$(date +%s)" bash "$shadow/copy2pvc.sh" "$1" "$2"
  rc=$?
  set -e
  finished_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  [[ ! -f "$shadow/job-id" ]] || job_name="$(<"$shadow/job-id")"
  record_transfer_event upload "$job_name" "$started_at" "$finished_at" "$rc" "$1" "/data/$2"
  return "$rc"
)

with_transfer_pod() (
  local remote="$1" callback="$2" local_path="$3"
  local suffix job pod
  suffix="$(date +%s)-$$"
  job="${USER_ALIAS}-pvc-download-${suffix}"
  local started_at
  started_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  cleanup_transfer() {
    local rc=$?
    record_transfer_event download "$job" "$started_at" \
      "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$rc" "/data/$remote" "$local_path" || true
    kubectl -n "$NAMESPACE" delete vcjob "$job" --ignore-not-found=true >/dev/null 2>&1 || true
  }
  trap cleanup_transfer EXIT
  kubectl create -f - >/dev/null <<YAML
apiVersion: batch.volcano.sh/v1alpha1
kind: Job
metadata:
  name: ${job}
  namespace: ${NAMESPACE}
  labels: {submitter: "${USER_ALIAS}", workstream: "${WORKSTREAM}"}
spec:
  queue: ${NAMESPACE}
  minAvailable: 1
  tasks:
    - name: transfer
      replicas: 1
      template:
        spec:
          schedulerName: volcano
          priorityClassName: high
          restartPolicy: Never
          containers:
            - name: transfer
              image: ${TRANSFER_IMAGE}
              command: [sh, -c, "sleep 3600"]
              resources:
                requests: {cpu: "2", memory: 4Gi}
                limits: {cpu: "2", memory: 4Gi}
              volumeMounts:
                - {name: data, mountPath: /data}
          volumes:
            - name: data
              persistentVolumeClaim: {claimName: ${PVC}}
YAML
  for _ in $(seq 1 60); do
    pod="$(kubectl -n "$NAMESPACE" get pod -l volcano.sh/job-name="$job" -o jsonpath='{.items[0].metadata.name}' 2>/dev/null || true)"
    [[ -n "$pod" ]] && break
    sleep 2
  done
  [[ -n "${pod:-}" ]] || die "transfer pod was not created"
  kubectl -n "$NAMESPACE" wait --for=condition=Ready "pod/$pod" --timeout=10m >/dev/null
  "$callback" "$pod" "$remote" "$local_path"
)

download_from_pod() {
  local pod="$1" remote="$2" local_dir="$3"
  [[ "$remote" != /* && "$remote" != *".."* ]] || die "REMOTE_DIR must be a safe /data-relative path"
  mkdir -p "$local_dir"
  kubectl -n "$NAMESPACE" exec "$pod" -- test -d "/data/$remote" \
    || die "remote directory not found: /data/$remote"
  kubectl -n "$NAMESPACE" exec "$pod" -- tar -C "/data/$remote" -czf - . \
    | tar -C "$local_dir" -xpzf -
  echo "Downloaded /data/$remote -> $local_dir"
}

cmd_download() {
  [[ $# -eq 2 ]] || die "download requires REMOTE_DIR LOCAL_DIR"
  require_p0
  cluster_checks
  with_transfer_pod "$1" download_from_pod "$2"
}

find_submitted_job() {
  local configured_name="$1" started_at="$2"
  kubectl -n "$NAMESPACE" get vcjob -l "submitter=$USER_ALIAS" \
    --request-timeout=15s \
    -o 'custom-columns=NAME:.metadata.name,CREATED:.metadata.creationTimestamp' \
    --no-headers | python3 -c '
from datetime import datetime
import sys

prefix, started = sys.argv[1:]
started_dt = datetime.fromisoformat(started.replace("Z", "+00:00"))
candidates = []
for line in sys.stdin:
    parts = line.split()
    if len(parts) != 2:
        continue
    name, created = parts
    if not name.startswith(prefix) or not created:
        continue
    created_dt = datetime.fromisoformat(created.replace("Z", "+00:00"))
    if created_dt >= started_dt:
        candidates.append((created_dt, name))
print(max(candidates)[1] if candidates else "")
' "${USER_ALIAS}-${configured_name}" "$started_at"
}

latest_staging_dir() {
  local configured_name="$1" started_at="$2" base candidate=""
  base="${LOCAL_OUT_DIR:-/tmp/volcano_jobs}/runs/${USER_ALIAS}"
  if [[ -d "$base" ]]; then
    candidate="$(find "$base" -mindepth 1 -maxdepth 1 -type d \
      -newermt "$started_at" \
      -name "${USER_ALIAS}-${configured_name}-*" -printf '%T@ %p\n' 2>/dev/null \
      | sort -n | tail -1 | cut -d' ' -f2-)"
  fi
  printf '%s\n' "$candidate"
}

monitor_submitted_job() (
  local job_name="$1" summary_file="$2"
  local interval="${B200_MONITOR_INTERVAL_SECONDS:-30}"
  local missing_limit="${B200_MONITOR_MISSING_LIMIT:-3}"
  [[ "$interval" =~ ^[0-9]+$ ]] \
    || die "B200_MONITOR_INTERVAL_SECONDS must be a nonnegative integer"
