{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://caveat.local/schemas/caveat-27b-observation-v1.json",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "run_id", "arm", "optimal_selection", "valid_transaction",
    "compiler_pass", "infrastructure_valid", "audit"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "minLength": 1},
    "optimal_selection": {"enum": [0, 1]},
    "valid_transaction": {"type": "boolean"},
    "compiler_pass": {"type": "boolean"},
    "infrastructure_valid": {"const": true},
    "audit": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "harness_sha256", "inference_contract_sha256", "safety_backstop_bound",
        "lossy_context_bound", "protocol_attempt_exhausted", "runtime_drift",
        "frozen_manifest_sha256", "matrix_sha256", "endpoint_manifest_sha256",
        "launch_manifest_sha256", "launch_config_sha256", "summary_sha256",
        "trajectory_sha256", "arm_weight_sha256", "recorded_value_matches_fresh"
      ],
      "properties": {
        "harness_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "inference_contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "safety_backstop_bound": {"type": "boolean"},
        "lossy_context_bound": {"type": "boolean"},
        "protocol_attempt_exhausted": {"type": "boolean"},
        "runtime_drift": {"type": "boolean"},
        "frozen_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "endpoint_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "launch_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "launch_config_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "summary_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "trajectory_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "arm_weight_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "recorded_value_matches_fresh": {"const": true}
      }
    }
  }
}
