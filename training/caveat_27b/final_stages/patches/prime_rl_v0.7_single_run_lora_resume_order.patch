+def _sampled_run_lora_signature(multi_run_manager) -> dict[str, int | str]:
+    """Return a distributed sampled signature for the registered run-0 LoRA.
+
+    Full nonzero counts make a post-restore zero reset fail deterministically;
+    fixed samples from every local shard also detect reinitialization without
+    copying the complete adapter to CPU.
+    """
+    named_parameters = list(multi_run_manager.get_named_parameters_for_run(0))
+    if not named_parameters:
+        raise RuntimeError("registered run 0 has no LoRA parameters")
+    local_parameters = []
+    local_lora_b_nonzero = 0
+    for name, parameter in named_parameters:
+        global_shape = list(parameter.shape)
+        value = parameter.detach()
+        if hasattr(value, "to_local"):
+            value = value.to_local()
+        flat = value.reshape(-1)
+        nonzero = int(torch.count_nonzero(flat).item())
+        sample_count = min(17, flat.numel())
+        if sample_count == 1:
+            sample_indices = [0]
+        else:
+            sample_indices = [
+                index * (flat.numel() - 1) // (sample_count - 1)
+                for index in range(sample_count)
+            ]
+        index_tensor = torch.tensor(sample_indices, dtype=torch.int64, device=flat.device)
+        samples = flat.index_select(0, index_tensor).to(dtype=torch.float32, device="cpu")
+        local_parameters.append(
+            {
+                "name": name,
+                "global_shape": global_shape,
+                "local_shape": list(value.shape),
+                "dtype": str(value.dtype),
+                "nonzero": nonzero,
+                "sample_indices": sample_indices,
+                "sample_float32_hex": [float(item).hex() for item in samples.tolist()],
+            }
+        )
+        if "lora_b" in name.casefold():
+            local_lora_b_nonzero += nonzero
+    local = {
+        "rank": dist.get_rank(),
+        "parameters": local_parameters,
+        "lora_b_nonzero": local_lora_b_nonzero,
+    }
+    ranks = [None] * dist.get_world_size()
+    dist.all_gather_object(ranks, local)
+    encoded = json.dumps(
+        {"world_size": dist.get_world_size(), "ranks": ranks},
+        sort_keys=True,
+        separators=(",", ":"),
+        allow_nan=False,
+    ).encode()
+    return {
+        "sha256": hashlib.sha256(encoded).hexdigest(),
+        "parameters_per_rank": len(named_parameters),
+        "lora_b_nonzero": sum(rank["lora_b_nonzero"] for rank in ranks),
+    }
+
+
+def _assert_single_run_optimizer_binding(multi_run_manager, optimizer) -> int:
+    registered = [
+        parameter
+        for _, parameter in list(multi_run_manager.get_named_parameters_for_run(0))
+        if parameter.requires_grad
+    ]
+    attached = [parameter for group in optimizer.param_groups for parameter in group["params"]]
+    if not registered or len(attached) != len(registered) or {
+        id(parameter) for parameter in attached
+    } != {id(parameter) for parameter in registered}:
+        raise RuntimeError("fresh optimizer is not attached to registered run-0 LoRA parameters")
+    return len(registered)
+
+
